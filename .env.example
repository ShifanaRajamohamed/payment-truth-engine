# DeepAudit AI — Environment Configuration Example
# Copy this file to .env and insert your real API credentials.

# Server Configuration
PORT=3000
NODE_ENV=development

# Google Gemini API Key (Strictly backend only)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Sarvam AI API Key (Strictly backend only)
# Get your key at: https://www.sarvam.ai/
SARVAM_API_KEY=

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/deepaudit

# Authentication Secrets
POSTGRES_PASSWORD=replace_with_a_strong_database_password
JWT_SECRET=replace_with_a_long_random_secret
DEMO_PASSWORD=replace_with_a_strong_demo_password
