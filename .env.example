# Payment Truth AI — Environment Configuration Example
# "When money is involved, everyone should see the same truth."
# Copy this file to .env and insert your optional API credentials.
# Note: Deterministic fallbacks are built-in for 100% offline hackathon evaluation.

# Server Configuration
PORT=3000
NODE_ENV=development

# Google Gemini API Key (Backend root cause reasoning)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Sarvam AI API Key (Indian Languages STT & TTS)
# Get your key at: https://www.sarvam.ai/
SARVAM_API_KEY=

# PostgreSQL Database Connection (Optional in mock mode)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/paymenttruth

# Authentication & Security Secrets
JWT_SECRET=super_secret_payment_truth_jwt_key_2026
DEMO_PASSWORD=truthadmin
